{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "hazor-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "BUILD_TESTS": "OFF",
        "HAZOR_DEVELOPMENT_PATHS": "OFF",
        "HAZOR_STRICT_DEPENDENCIES": "ON"
      },
      "environment": {
        "HAZOR_THIRD_PARTY_DIR": "${sourceDir}/3rdparty"
      }
    },
    {
      "name": "linux-x86_64-release",
      "inherits": "hazor-base",
      "binaryDir": "${sourceDir}/build/linux-x86_64-release",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-x86_64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HAZOR_DEPENDENCY_ROOT": "$env{HAZOR_THIRD_PARTY_DIR}/targets/linux-x86_64",
        "CMAKE_PREFIX_PATH": "$env{HAZOR_THIRD_PARTY_DIR}/targets/linux-x86_64/qt/6.8.3/gcc_64;$env{HAZOR_THIRD_PARTY_DIR}/targets/linux-x86_64/opencv/4.5.4;$env{HAZOR_THIRD_PARTY_DIR}/targets/linux-x86_64/zlib/1.3.2",
        "Qt6_DIR": "$env{HAZOR_THIRD_PARTY_DIR}/targets/linux-x86_64/qt/6.8.3/gcc_64/lib/cmake/Qt6",
        "QT_HOST_PATH": "$env{HAZOR_THIRD_PARTY_DIR}/host/linux-x86_64/qt/6.8.3/gcc_64",
        "OpenCV_DIR": "$env{HAZOR_THIRD_PARTY_DIR}/targets/linux-x86_64/opencv/4.5.4/lib/cmake/opencv4",
        "ZLIB_ROOT": "$env{HAZOR_THIRD_PARTY_DIR}/targets/linux-x86_64/zlib/1.3.2",
        "RAWENGINE_DEPS_DIR": "$env{HAZOR_THIRD_PARTY_DIR}/targets/linux-x86_64/rawengine",
        "ONNXRUNTIME_ROOT": "$env{HAZOR_THIRD_PARTY_DIR}/targets/linux-x86_64/onnxruntime/1.26.0/onnxruntime-linux-x64-gpu-1.26.0"
      },
      "environment": {
        "HAZOR_TARGET_ROOT": "$env{HAZOR_THIRD_PARTY_DIR}/targets/linux-x86_64"
      }
    },
    {
      "name": "windows-x86_64-release",
      "inherits": "hazor-base",
      "binaryDir": "${sourceDir}/build/windows-x86_64-release",
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-mingw-x86_64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HAZOR_DEPENDENCY_ROOT": "$env{HAZOR_THIRD_PARTY_DIR}/targets/windows-x86_64",
        "CMAKE_PREFIX_PATH": "$env{HAZOR_THIRD_PARTY_DIR}/targets/windows-x86_64/qt/6.8.3/mingw_64;$env{HAZOR_THIRD_PARTY_DIR}/targets/windows-x86_64/opencv/4.5.4;$env{HAZOR_THIRD_PARTY_DIR}/targets/windows-x86_64/zlib/1.3.2",
        "Qt6_DIR": "$env{HAZOR_THIRD_PARTY_DIR}/targets/windows-x86_64/qt/6.8.3/mingw_64/lib/cmake/Qt6",
        "QT_HOST_PATH": "$env{HAZOR_THIRD_PARTY_DIR}/host/linux-x86_64/qt/6.8.3/gcc_64",
        "OpenCV_DIR": "$env{HAZOR_THIRD_PARTY_DIR}/targets/windows-x86_64/opencv/4.5.4/lib/cmake/opencv4",
        "ZLIB_ROOT": "$env{HAZOR_THIRD_PARTY_DIR}/targets/windows-x86_64/zlib/1.3.2",
        "ENABLE_ONNXRUNTIME": "OFF",
        "ENABLE_RAWENGINE": "OFF"
      },
      "environment": {
        "HAZOR_TARGET_ROOT": "$env{HAZOR_THIRD_PARTY_DIR}/targets/windows-x86_64"
      }
    },
    {
      "name": "macos-base",
      "hidden": true,
      "inherits": "hazor-base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/macos-osxcross.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_RAWENGINE": "OFF"
      }
    },
    {
      "name": "macos-x86_64-release",
      "inherits": "macos-base",
      "binaryDir": "${sourceDir}/build/macos-x86_64-release",
      "cacheVariables": {
        "HAZOR_DEPENDENCY_ROOT": "$env{HAZOR_THIRD_PARTY_DIR}/targets/macos-x86_64",
        "CMAKE_PREFIX_PATH": "$env{HAZOR_THIRD_PARTY_DIR}/targets/macos-x86_64/qt/6.8.3/macos;$env{HAZOR_THIRD_PARTY_DIR}/targets/macos-x86_64/opencv/4.5.4;$env{HAZOR_THIRD_PARTY_DIR}/targets/macos-x86_64/zlib/1.3.2",
        "Qt6_DIR": "$env{HAZOR_THIRD_PARTY_DIR}/targets/macos-x86_64/qt/6.8.3/macos/lib/cmake/Qt6",
        "QT_HOST_PATH": "$env{HAZOR_THIRD_PARTY_DIR}/host/linux-x86_64/qt/6.8.3/gcc_64",
        "OpenCV_DIR": "$env{HAZOR_THIRD_PARTY_DIR}/targets/macos-x86_64/opencv/4.5.4/lib/cmake/opencv4",
        "ZLIB_ROOT": "$env{HAZOR_THIRD_PARTY_DIR}/targets/macos-x86_64/zlib/1.3.2",
        "ENABLE_ONNXRUNTIME": "OFF"
      },
      "environment": {
        "HAZOR_TARGET_ROOT": "$env{HAZOR_THIRD_PARTY_DIR}/targets/macos-x86_64",
        "HAZOR_TARGET_ARCH": "x86_64"
      }
    },
    {
      "name": "macos-arm64-release",
      "inherits": "macos-base",
      "binaryDir": "${sourceDir}/build/macos-arm64-release",
      "cacheVariables": {
        "HAZOR_DEPENDENCY_ROOT": "$env{HAZOR_THIRD_PARTY_DIR}/targets/macos-arm64",
        "CMAKE_PREFIX_PATH": "$env{HAZOR_THIRD_PARTY_DIR}/targets/macos-arm64/qt/6.8.3/macos;$env{HAZOR_THIRD_PARTY_DIR}/targets/macos-arm64/opencv/4.5.4;$env{HAZOR_THIRD_PARTY_DIR}/targets/macos-arm64/zlib/1.3.2",
        "Qt6_DIR": "$env{HAZOR_THIRD_PARTY_DIR}/targets/macos-arm64/qt/6.8.3/macos/lib/cmake/Qt6",
        "QT_HOST_PATH": "$env{HAZOR_THIRD_PARTY_DIR}/host/linux-x86_64/qt/6.8.3/gcc_64",
        "OpenCV_DIR": "$env{HAZOR_THIRD_PARTY_DIR}/targets/macos-arm64/opencv/4.5.4/lib/cmake/opencv4",
        "ZLIB_ROOT": "$env{HAZOR_THIRD_PARTY_DIR}/targets/macos-arm64/zlib/1.3.2",
        "ONNXRUNTIME_ROOT": "$env{HAZOR_THIRD_PARTY_DIR}/targets/macos-arm64/onnxruntime/1.26.0/onnxruntime-osx-arm64-1.26.0"
      },
      "environment": {
        "HAZOR_TARGET_ROOT": "$env{HAZOR_THIRD_PARTY_DIR}/targets/macos-arm64",
        "HAZOR_TARGET_ARCH": "arm64"
      }
    }
  ],
  "buildPresets": [
    { "name": "linux-x86_64-release", "configurePreset": "linux-x86_64-release", "targets": ["Hazor"] },
    { "name": "windows-x86_64-release", "configurePreset": "windows-x86_64-release", "targets": ["Hazor"] },
    { "name": "macos-x86_64-release", "configurePreset": "macos-x86_64-release", "targets": ["Hazor"] },
    { "name": "macos-arm64-release", "configurePreset": "macos-arm64-release", "targets": ["Hazor"] }
  ]
}
