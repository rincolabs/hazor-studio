# Writes a .qrc listing every file Vite produced under embedded-ui/dist.
#
# Generated rather than checked in because the asset names carry a content hash:
# a committed list would name files that no longer exist after the first edit to
# the frontend. The resource paths are the dist-relative ones, so the layout the
# page sees (neural-flow/index.html next to assets/) is the layout Vite built.
#
# Run at build time:
#   cmake -DDIST_DIR=<dist> -DQRC_FILE=<out.qrc> [-DRESOURCE_PREFIX=/embedded-ui]
#         -P cmake/GenerateEmbeddedUiQrc.cmake

if(NOT DEFINED DIST_DIR OR NOT DEFINED QRC_FILE)
    message(FATAL_ERROR "GenerateEmbeddedUiQrc.cmake requires -DDIST_DIR and -DQRC_FILE")
endif()
if(NOT DEFINED RESOURCE_PREFIX)
    set(RESOURCE_PREFIX "/embedded-ui")
endif()
if(NOT IS_DIRECTORY "${DIST_DIR}")
    message(FATAL_ERROR
        "No embedded-ui build found at '${DIST_DIR}'. Run `npm ci && npm run build` in "
        "embedded-ui/, or configure with -DENABLE_EMBEDDED_UI=OFF.")
endif()

file(GLOB_RECURSE _files RELATIVE "${DIST_DIR}" "${DIST_DIR}/*")
# Sorted so the generated file — and therefore rcc's output and the object file
# compiled from it — is reproducible rather than filesystem-order dependent.
list(SORT _files)
if(NOT _files)
    message(FATAL_ERROR "The embedded-ui build at '${DIST_DIR}' is empty.")
endif()

set(_entries "")
foreach(_file IN LISTS _files)
    # Absolute path with an alias: rcc resolves a relative <file> against the
    # .qrc's own directory, and this .qrc lives in the build tree while the
    # files live under embedded-ui/.
    string(APPEND _entries "        <file alias=\"${_file}\">${DIST_DIR}/${_file}</file>\n")
endforeach()

set(_content
"<!-- Generated by cmake/GenerateEmbeddedUiQrc.cmake. Do not edit. -->\n\
<RCC>\n\
    <qresource prefix=\"${RESOURCE_PREFIX}\">\n\
${_entries}\
    </qresource>\n\
</RCC>\n")

# Left untouched when nothing changed, so rcc does not re-run and the multi-
# megabyte translation unit it produces does not recompile on every build. The
# cost is that this script itself runs each time, which is milliseconds.
if(EXISTS "${QRC_FILE}")
    file(READ "${QRC_FILE}" _existing)
    if(_existing STREQUAL _content)
        return()
    endif()
endif()
file(WRITE "${QRC_FILE}" "${_content}")
